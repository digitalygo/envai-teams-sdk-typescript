{
  "name": "@digitalygo/envai-client",
  "version": "0.1.0-alpha.1",
  "description": "Typed Node.js client for Envai Teams HTTP and ATP v2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**/*.js' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 tests/*.test.mjs",
    "check": "npm run check:generated && npm run typecheck && npm test",
    "prepack": "npm run build",
    "check:package": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalygo/envai-teams-sdk-typescript.git"
  }
}
